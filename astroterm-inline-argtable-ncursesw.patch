+.\"
+.\" $Id: bs.6,v 1.8 2024/06/15 20:32:28 tom Exp $
+.TH BATTLESHIPS 6 2024-06-15 ncurses-examples Games
+.ie \n(.g \{\
+.ds `` \(lq
