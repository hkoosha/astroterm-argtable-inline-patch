+	[cf_cv_define_sigwinch=yes],
+	[AC_COMPILE_IFELSE([AC_LANG_PROGRAM([
+#undef _XOPEN_SOURCE
+#undef _POSIX_SOURCE
+#undef _POSIX_C_SOURCE
+#include <sys/types.h>
+#include <sys/signal.h>
+],[int x = SIGWINCH; (void)x])],
