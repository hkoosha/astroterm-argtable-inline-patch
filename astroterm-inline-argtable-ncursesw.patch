+.\" $Id: curs_threads.3x,v 1.59 2025/02/15 19:41:22 tom Exp $
+.TH curs_threads 3X 2025-02-15 "ncurses @NCURSES_MAJOR@.@NCURSES_MINOR@" "Library calls"
+.ie \n(.g \{\
