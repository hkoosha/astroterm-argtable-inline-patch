+
+    my_fp = stdout;
+
+    while ((ch = getopt(argc, argv, OPTS_COMMON "enp")) != -1) {
+	switch (ch) {
+	case 'e':
+	    my_fp = stderr;
+	    break;
+	case 'n':
+	    no_init = TRUE;
+	    break;
+	case 'p':
+	    p_opt = TRUE;
