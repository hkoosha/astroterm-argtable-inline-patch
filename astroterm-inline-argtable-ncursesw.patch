+static char dftname[] = "stranger";
+
+/* direction constants */
+typedef enum {
+    dir_E = 0
+    ,dir_SE
+    ,dir_S
+    ,dir_SW
+    ,dir_W
+    ,dir_NW
+    ,dir_N
+    ,dir_NE
+    ,dir_MAX
+} DIRECTIONS;
+static int xincr[dir_MAX + 2] =
+{1, 1, 0, -1, -1, -1, 0, 1};
+static int yincr[dir_MAX + 2] =
