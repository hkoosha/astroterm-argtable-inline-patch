+/* ./fld_arg.c */
+
+#undef set_fieldtype_arg
+int	set_fieldtype_arg(
+		FIELDTYPE *typ,
+		void	*(*const make_arg)(
+		va_list	*p1),
+		void	*(*const copy_arg)(
+		const void *p1),
+		void	(*const free_arg)(
+		void	*p1))
+		{ return(*(int *)0); }
