+++ b/third_party/ncurses/misc/ncurses-config.in
@@ -0,0 +1,383 @@
+#!@SHELL@
+# $Id: ncurses-config.in,v 1.63 2025/11/22 19:19:28 tom Exp $
+##############################################################################
+# Copyright 2018-2024,2025 Thomas E. Dickey                                  #
