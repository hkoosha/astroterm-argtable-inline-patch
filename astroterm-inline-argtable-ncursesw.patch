+/* lib_color.c
+ *
+ * Handles color emulation of SYS V curses
+ */
+
+#define NEW_PAIR_INTERNAL 1
+
+#include <curses.priv.h>
+#include <new_pair.h>
+#include <tic.h>
+
+#ifndef CUR
+#define CUR SP_TERMTYPE
