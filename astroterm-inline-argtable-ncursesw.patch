+				LIBS="-L$cf_libdir -l$1 $cf_save_LIBS"
+				AC_LINK_IFELSE([AC_LANG_PROGRAM([$3],[$4])],
+					[AC_MSG_RESULT(yes)
+			 		 eval 'cf_cv_have_lib_'"$1"'=yes'
+					 break],
+					[AC_MSG_RESULT(no)
+					 LIBS="$cf_save_LIBS"])
+			done
+			])
+		])
+eval 'cf_found_library="[$]cf_cv_have_lib_'"$1"\"
+ifelse($6,,[
+if test "$cf_found_library" = no ; then
+	AC_MSG_ERROR(Cannot link $1 library)
