+ */
+#include "panel.priv.h"
+
+MODULE_ID("$Id: p_user.c,v 1.11 2021/06/17 21:20:30 tom Exp $")
+
+PANEL_EXPORT(int)
+set_panel_userptr(PANEL * pan, NCURSES_CONST void *uptr)
+{
+  T((T_CALLED("set_panel_userptr(%p,%p)"), (void *)pan, (NCURSES_CONST void *)uptr));
+  if (!pan)
+    returnCode(ERR);
+  pan->user = uptr;
+  returnCode(OK);
+}
