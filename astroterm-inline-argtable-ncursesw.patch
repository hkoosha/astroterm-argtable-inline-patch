+##############################################################################
+#
+# MKkey_defs.sh -- generate list of function-keys for terminfo database
+#
+# Author: Thomas E. Dickey 2001
+#
+# Extract function-key names from the Caps file
+#
+: "${AWK-awk}"
+: "${USE_SIGWINCH-0}"
+
+data=data$$
+tabs='s/[	][	]*/	/g'
+trap 'rm -f $data; exit 1' 1 2 3 15
+trap 'rm -f $data' 0
+if [ $# != 0 ]
+then
+	sed -e "$tabs" "$@" >$data
+else
+	sed -e "$tabs" ../../include/Caps >$data
+fi
+
+cat <<EOF
+# These definitions were generated by $0 $*
+KEY_BREAK
+KEY_SRESET
+KEY_RESET
+EOF
+[ "$USE_SIGWINCH" = 1 ] && echo KEY_RESIZE
+
+${AWK-awk} <$data '
+/^#/		{next;}
+/^capalias/	{next;}
+/^infoalias/	{next;}
+/^userdef/	{next;}
+
+$5 != "-" {
+		if (substr($5, 1, 4) == "KEY_" ) {
+			printf "%s	%s\n", $5, $1
+	}
+}
+'
