+###	Default install-location
+CF_CFG_DEFAULTS
+
+###	Checks for programs.
+CF_WITH_ADA
+AC_PROG_CPP
+AC_PROG_GCC_TRADITIONAL
+CF_PROG_CC_C_O(CC,[$CFLAGS $CPPFLAGS])
