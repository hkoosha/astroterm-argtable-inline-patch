diff --git a/third_party/ncurses/meson.build b/third_party/ncurses/meson.build
new file mode 100644
index 0000000000000000000000000000000000000000..34016771a18d2aafe64e44d232e7acfa9d56ac5d
--- /dev/null
+++ b/third_party/ncurses/meson.build
@@ -0,0 +1,38 @@
+python = import('python').find_installation()
+ncurses_build_args = [
+    '--make', find_program('make').full_path(),
+]
+foreach arg : cc.cmd_array()
+    ncurses_build_args += '--cc=' + arg
+endforeach
+foreach arg : get_option('c_args')
+    ncurses_build_args += '--cflag=' + arg
+endforeach
+foreach arg : get_option('c_link_args')
+    ncurses_build_args += '--ldflag=' + arg
+endforeach
+if meson.is_cross_build()
+    ncurses_build_args += [
+        '--host=' + host_machine.cpu() + '-unknown-' + host_machine.system(),
+        '--build=' + build_machine.cpu() + '-unknown-' + build_machine.system(),
+    ]
+    foreach arg : meson.get_compiler('c', native: true).cmd_array()
+        ncurses_build_args += '--build-cc=' + arg
+    endforeach
+endif
+
+ncurses_outputs = custom_target(
+    'bundled-ncursesw',
+    depend_files: files(fs.read('MANIFEST').strip().split('\n')) + files('fallback.c'),
+    output: ['libncursesw.a', 'curses.h', 'ncurses_dll.h', 'unctrl.h'],
+    command: [
+        python, files('build.py'), meson.current_source_dir(), meson.current_build_dir(),
+        ncurses_build_args,
+    ],
+)
+curses = declare_dependency(
+    link_with: ncurses_outputs[0],
+    sources: [ncurses_outputs[1], ncurses_outputs[2], ncurses_outputs[3]],
+    include_directories: include_directories('.'),
+    compile_args: '-D_XOPEN_SOURCE_EXTENDED=1',
+)
