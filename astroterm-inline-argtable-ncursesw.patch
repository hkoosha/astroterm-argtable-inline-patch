+	 $4
+])
+		;;
+	esac],
+	[with_$1=])
+AC_MSG_RESULT(${with_$1:-no})
+
+case ".$with_cflags" in
+(.*-g*)
+	case .$CFLAGS in
+	(.*-g*)
+		;;
+	(*)
+		CF_ADD_CFLAGS([-g])
+		;;
+	esac
+	;;
+esac
+])dnl
