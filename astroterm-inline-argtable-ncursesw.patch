index 0000000000000000000000000000000000000000..a02d69c548609a070b51494222038cb0c62a0cfc
--- /dev/null
+++ b/third_party/ncurses/test/demo_menus.c
@@ -0,0 +1,1060 @@
+/****************************************************************************
