+static char *
+wcstos(const wchar_t *src)
+{
+    int need;
+    char *result = NULL;
+    const wchar_t *tmp = src;
+#ifndef state_unused
+    mbstate_t state;
+#endif
+
+    reset_wchars(state);
+    if ((need = (int) count_wchars(tmp, 0, &state)) > 0) {
+	unsigned have = (unsigned) need;
+	if ((result = typeCalloc(char, have + 1)) != NULL) {
+	    tmp = src;
+	    if (trans_wchars(result, tmp, have, &state) != have) {
+		free(result);
+		result = NULL;
+	    }
+	} else {
+	    failed("wcstos");
+	}
+    }
+    return result;
+}
