+|
+|   Description   :  Set or clear the 'changed' indication flag for that
+|                    field's primary buffer.
+|
+|   Return Values :  E_OK            - success
++--------------------------------------------------------------------------*/
+FORM_EXPORT(int)
+set_field_status(FIELD *field, bool status)
