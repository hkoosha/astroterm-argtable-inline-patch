+#if HAVE_NEWPAD
+static void
+padTest(WINDOW *dummy GCC_UNUSED)
+{
+    WINDOW *pad;
+
+    if ((pad = newpad(50, 100)) != NULL) {
+	WINDOW *spad;
+
+	wattron(pad, A_REVERSE);
+	MvWAddStr(pad, 5, 2, "This is a new pad");
+	(void) wattrset(pad, A_NORMAL);
+	MvWAddStr(pad, 8, 0,
