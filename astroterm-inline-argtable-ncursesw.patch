+static int
+blinkit(void)
+{
+    static int cycle;
+
+    if (cycle > 4) {
+	cycle = 0;
+    }
+
+    touchwin(treescrn8);
+
+    switch (cycle) {
+    case 0:
+	overlay(treescrn3, treescrn8);
+	break;
+    case 1:
+	overlay(treescrn4, treescrn8);
+	break;
+    case 2:
+	overlay(treescrn5, treescrn8);
+	break;
+    case 3:
+	overlay(treescrn6, treescrn8);
+	break;
+    case 4:
+	overlay(treescrn7, treescrn8);
+	break;
+    }
+    touchwin(treescrn8);
+    wrefresh(treescrn8);
+    wrefresh(w_del_msg);
+    look_out(50);
+
+    /*ALL ON************************************************** */
+
+    overlay(treescrn, treescrn8);
+    wrefresh(treescrn8);
+    wrefresh(w_del_msg);
+    look_out(50);
+
+    ++cycle;
+    return (0);
+}
