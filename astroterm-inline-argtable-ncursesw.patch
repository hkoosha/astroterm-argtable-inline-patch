diff --git a/third_party/ncurses/build.py b/third_party/ncurses/build.py
new file mode 100644
index 0000000000000000000000000000000000000000..22b3a98b8029092f5f70b91431ab5d060fedc63a
--- /dev/null
+++ b/third_party/ncurses/build.py
@@ -0,0 +1,93 @@
+import argparse
+import os
+from pathlib import Path
+import shlex
+import shutil
+import subprocess
+import sys
+import tempfile
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("source", type=Path)
+    parser.add_argument("output", type=Path)
+    parser.add_argument("--make", required=True)
+    parser.add_argument("--cc", action="append", required=True)
+    parser.add_argument("--cflag", action="append", default=[])
+    parser.add_argument("--ldflag", action="append", default=[])
+    parser.add_argument("--host")
+    parser.add_argument("--build")
+    parser.add_argument("--build-cc", action="append")
+    args = parser.parse_args()
+
+    source = args.source.resolve()
+    output = args.output.resolve()
+    env = os.environ.copy()
+    env["CC"] = shlex.join(args.cc)
+    if args.cflag:
+        env["CFLAGS"] = shlex.join(args.cflag)
+    if args.ldflag:
+        env["LDFLAGS"] = shlex.join(args.ldflag)
+    if args.build_cc:
+        env["BUILD_CC"] = shlex.join(args.build_cc)
+
+    with tempfile.TemporaryDirectory(prefix="ncurses-", dir=output) as temp:
+        work = Path(temp)
+        build = work / "build"
+        build.mkdir()
+        commands = [
+            [
+                "sh", str(source / "configure"),
+                "--prefix=/usr",
+                "--enable-widec",
+                "--with-normal",
+                "--without-shared",
+                "--without-debug",
+                "--without-profile",
+                "--without-termlib",
+                "--without-ticlib",
+                "--without-progs",
+                "--without-tests",
+                "--without-manpages",
+                "--without-ada",
+                "--without-cxx",
+                "--without-cxx-binding",
+                "--without-gpm",
+                "--without-pthread",
+                "--disable-db-install",
+                "--disable-termcap",
+                "--with-terminfo-dirs=/etc/terminfo:/lib/terminfo:/usr/share/terminfo:"
+                "/usr/share/misc/terminfo:/usr/local/share/terminfo",
+            ],
+            [args.make, "-C", str(build / "include")],
+        ]
+        if args.host:
+            commands[0] += ["--host=" + args.host, "--build=" + args.build]
+
+        log_path = output / "ncurses-build.log"
+        try:
+            with log_path.open("w") as log:
+                for command in commands:
+                    subprocess.run(
+                        command, cwd=build, env=env, stdout=log,
+                        stderr=subprocess.STDOUT, check=True,
+                    )
+                # Embed pre-generated terminal descriptions without host tic/infocmp.
+                shutil.copyfile(source / "fallback.c", build / "ncurses/fallback.c")
+                subprocess.run(
+                    [args.make, "-C", str(build / "ncurses")],
+                    cwd=build, env=env, stdout=log,
+                    stderr=subprocess.STDOUT, check=True,
+                )
+        except subprocess.CalledProcessError as error:
+            sys.stderr.write(log_path.read_text())
+            raise SystemExit(error.returncode)
+
+        shutil.copyfile(build / "lib/libncursesw.a", output / "libncursesw.a")
+        for header in ("curses.h", "ncurses_dll.h", "unctrl.h"):
+            shutil.copyfile(build / "include" / header, output / header)
+
+
+if __name__ == "__main__":
+    main()
