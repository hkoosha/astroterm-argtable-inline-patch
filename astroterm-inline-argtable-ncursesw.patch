+#!/bin/sh
+##############################################################################
+# Copyright 2020-2021,2025 Thomas E. Dickey                                  #
+# Copyright 1998,2000 Free Software Foundation, Inc.                         #
+#                                                                            #
+# Permission is hereby granted, free of charge, to any person obtaining a    #
